vec2 outlineOffsets[12] = vec2[12](
    vec2( 0.0,  1.0),
    vec2( 1.0,  0.0),
    vec2( 1.0,  1.0),
    vec2(-1.0,  1.0),
    vec2( 2.0,  0.0),
    vec2( 0.0,  2.0),
    vec2( 2.0,  1.0),
