value.PALETTE_COLOR_MATCH.1=§bConscient des Couleurs§r

option.DITHER_INVERSE_DOTS=Inverser les Points
option.DITHER_INVERSE_DOTS.comment=Inverser les couleurs. §eDÉSACTIVÉ§r = points clairs sur sombre. §eACTIVÉ§r = points sombres sur clair.

option.DITHER_RADIAL_COMP=Compensation Radiale
option.DITHER_RADIAL_COMP.comment=Stabilise la densité lors de la rotation de la caméra.

option.DITHER_QUANTIZE_LAYERS=Quantifier les Couches
option.DITHER_QUANTIZE_LAYERS.comment=Empêche la transformation progressive. Transitions plus nettes.

option.DITHER_DEBUG_FRACTAL=Déboguer Fractal
option.DITHER_DEBUG_FRACTAL.comment=Affiche la couche fractale utilisée à chaque pixel.

